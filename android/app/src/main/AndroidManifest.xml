<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".JarvisApp"
        android:allowBackup="true"
        android:label="Jarvis"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jarvis">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Jarvis">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".VoiceCallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Push (Faz Y3). exported=false is correct even though the platform starts it:
             the MESSAGING_EVENT intent comes from Play Services through the Firebase SDK
             in this same process, not from another app. -->
        <service
            android:name=".JarvisFCMService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Used ONLY on the background/system-tray path, where JarvisFCMService is never
             called and Firebase builds the notification itself. Without these two it would
             fall back to a "Miscellaneous" channel and the launcher icon. The channel is
             created in JarvisApp.onCreate so it exists by the time a push arrives. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="jarvis_push" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/logo_kj" />
    </application>

</manifest>
