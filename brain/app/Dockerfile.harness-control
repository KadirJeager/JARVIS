FROM python:3.12-slim

WORKDIR /srv
RUN pip install --no-cache-dir \
    "fastapi>=0.115,<1" \
    "uvicorn>=0.30,<1" \
    "google-auth[requests]>=2.30,<3" \
    "google-cloud-firestore>=2.16,<3" \
    "httpx>=0.27,<1" \
    && useradd --create-home appuser

RUN mkdir /srv/app
COPY app/__init__.py app/harness_control.py app/harness_tasks.py app/chat_delivery.py app/hermes_model_api.py ./app/
USER appuser
ENV PORT=8080
CMD ["sh", "-c", "exec uvicorn app.harness_control:app --host 0.0.0.0 --port ${PORT}"]
