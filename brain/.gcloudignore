# Build-context exclusions for `gcloud builds submit`, which does NOT read
# .dockerignore and does NOT find the repo-root .gitignore when the source dir
# is brain/ -- it looks for .gitignore in the submitted directory itself. Without
# this file the upload was 2.5 GiB (65k files): both interpreters, torch and all.
#
# Keep in step with .dockerignore. Two files because they gate two different
# stages: this one what gets UPLOADED, that one what reaches the daemon.
.venv
.venv-speaker
tests
__pycache__
*.pyc
*.egg-info
.pytest_cache
.env
client_secret*.json
