# Copy to installation.env (not committed) and fill in for your installation.
PROJECT_ID=
REGION=
# Cloud Run service name; also prefixes the queue, service accounts and repository.
SERVICE=
# Comma-separated verified Google account emails allowed to use the assistant.
ALLOWED_EMAILS=
# Firebase web app id (Project settings > Your apps) the PWA signs in with.
FIREBASE_WEB_APP_ID=
# 1 to run the CLIProxyAPI sidecar for a subscription OAuth model path.
CLIPROXY=0
CLIPROXY_KEY_SECRET=
CLIPROXY_OAUTH_SECRET=
# Other Secret Manager secrets the model settings reference, space-separated.
EXTRA_SECRETS=
