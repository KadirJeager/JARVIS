rules_version = '2';

// Clients only read their own conversation state; every write goes through the
// authenticated API. Memory (vault), step persistence and counters are
// server-only, so they have no rule and stay denied by default.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      match /conversations/{conversationId} {
        allow read: if isOwner(uid);

        match /messages/{messageId} {
          allow read: if isOwner(uid);
        }
      }

      match /settings/{document} {
        allow read: if isOwner(uid);
      }

      match /settings_history/{version} {
        allow read: if isOwner(uid);
      }
    }

    match /turns/{turnId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
